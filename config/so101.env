# SO-ARM_ws 설정 — 모든 scripts/*.sh 가 scripts/activate.sh 를 통해 이 파일을 불러온다.
# 값은 https://github.com/jaemin0319/so101-ws (config/so101.env, 2026-10-23 이 노트북에서 실측) 에서 가져왔다.
# 이 파일을 고친 뒤에는 새 터미널을 열거나 `source scripts/activate.sh` 를 다시 실행한다.
# 토큰·비밀번호는 넣지 않는다(Hugging Face 로그인은 `hf auth login`).

# ---- conda 환경 ----
SO101_ENV_NAME=so-arm_ws

# ---- Hugging Face ----
# 데이터셋/모델 repo_id 앞부분. `hf auth whoami` 결과와 같아야 업로드가 된다.
HF_USER=jammin0319

# ---- 로봇 팔 (Feetech STS3215 x6, CH343 USB 시리얼 보드 1a86:55d3) ----
# by-id = 보드 시리얼 번호 기준이라 다른 USB 포트에 꽂아도 경로가 같다.
# 구분 근거(2026-10-23): 모터 전압 follower 12.0~12.2V(12V 전원), leader 6.1~6.2V(5V 전원).
# 포트를 다시 찾을 때: lerobot-find-port (케이블을 뽑았다 꽂는 방식)
SO101_ROBOT_TYPE=so101_follower
SO101_TELEOP_TYPE=so101_leader
SO101_FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90151504-if00
SO101_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90151751-if00
# ID = 보정 파일 이름: calibration/robots/so_follower/<ID>.json, calibration/teleoperators/so_leader/<ID>.json
SO101_FOLLOWER_ID=so101_follower
SO101_LEADER_ID=so101_leader

# ---- 카메라 (Innomaker U20CAM-720P x2, 0c45:6367) ----
# 두 카메라의 USB 시리얼이 같아(SN0001) /dev/v4l/by-id 는 재부팅마다 바뀐다 → USB 포트 위치 기준 by-path 사용.
# USB 2.0 허브(Genesys 05e3:0610) 배치: 2.1 = wrist, 2.2 = follower, 2.3 = leader, 2.4 = front. 같은 구멍에 꽂아야 경로가 유지된다.
# 경로가 바뀌면: python scripts/cameras.py list → snap --all 로 찍어 보고 아래 두 줄을 고친다.
SO101_CAM_FRONT=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2.4:1.0-video-index0
SO101_CAM_WRIST=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:2.1:1.0-video-index0
SO101_CAM_WIDTH=640
SO101_CAM_HEIGHT=480
SO101_CAM_FPS=30
# front 는 작업면을 위에서 내려다보도록 거꾸로 달려 있어 180도 회전(학습 데이터와 동일). 가능 값: 0, 90, 180, -90
SO101_CAM_FRONT_ROTATION=180
SO101_CAM_WRIST_ROTATION=0
# 카메라 2대가 USB 2.0 허브 하나를 같이 써서 YUYV(비압축)면 front 150장 중 31~36장이 깨짐(실측). MJPG 필수.
SO101_CAM_FOURCC=MJPG

# ---- 작업 공간 안 저장 위치 (SO101_WS 는 activate.sh 가 정한다) ----
# LeRobot 데이터셋 루트: 녹화/다운로드한 데이터셋은 data/<user>/<name> 에 생긴다.
HF_LEROBOT_HOME=$SO101_WS/data
# LeRobot 보정 파일 위치
HF_LEROBOT_CALIBRATION=$SO101_WS/calibration
# 허브에서 받은 모델: models/<name>
SO101_MODEL_DIR=$SO101_WS/models
# 학습 결과: outputs/train/<job_name>
SO101_OUTPUT_DIR=$SO101_WS/outputs

# ---- 녹화 기본값 (scripts/record.sh 옵션으로 덮어쓸 수 있다) ----
SO101_RECORD_FPS=30
SO101_RECORD_EPISODE_TIME_S=30
SO101_RECORD_RESET_TIME_S=10

# ---- 학습 기본값 (scripts/train.sh 옵션으로 덮어쓸 수 있다) ----
# RTX 5060 Laptop 8GB 기준. ACT batch 8 로 기존 모델(jammin0319/act_so101_ball_to_bowl_v1)을 학습했다.
SO101_TRAIN_POLICY=act
SO101_TRAIN_STEPS=100000
SO101_TRAIN_BATCH_SIZE=8
SO101_TRAIN_SAVE_FREQ=20000
